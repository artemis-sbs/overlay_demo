            trap_b_text = gui_text("$text:`Elapsed 0s`;font:gui-3;color:#8cf;justify:center;")
            on change int(get_counter_elapsed_seconds(client_id, "trap_clock", 0)):
                trap_b_n = int(get_counter_elapsed_seconds(client_id, "trap_clock", 0))
                trap_b_text.update(f"text:`Elapsed {trap_b_n}s`;font:gui-3;color:#8cf;justify:center;")
# <<gallery

