# ============================================================================
# CONTROL GALLERY -- the shell, and the Controls category.
#
# Pick "Control Gallery" from the console list. Left: the index. Right: the
# live control, and under it THE SOURCE THAT BUILT IT -- sliced out of this
# file at runtime between `# >>gallery: key` and `# <<gallery`, so the snippet
# can never drift from the specimen.
#
# The shell is deliberately built out of the patterns the cosmos-gui skill
# mandates (listbox + detail, title_template, watch/repaint), so reading this
# file is the second lesson.
#
# Plan: sbs_utils/GALLERY_PLAN.md
# ============================================================================

@console/gallery !0 ^0 "Control Gallery"
    " Every GUI control, live, next to the source that built it.
    jump gallery_screen


# Entered three ways: the console label above, a repaint jump, and the SERVER
# screen (story.mast reroutes the server here once the map is up, so the gallery
# is available without connecting a console or having a ship). Hence the
# `default` lives here rather than only in the console body.
=== gallery_screen
    # This screen is NOT the viewer. Said out loud because the role is what the
    # audience dial and the morph address, and roles outlive the page that added
    # them: a client that visited the Gallery Viewer and then came back here would
    # still answer to role("gallery_viewer") -- so "Morph the viewer" would morph
    # the gallery you are reading it on. Every screen clears the roles it is not.
    remove_role(client_id, "gallery_viewer")
    default gallery_spec = "text_basic"
    # Order no longer matters: the page restores the button to what was ASKED
    # for, so this holds across every rebuild. (Calling
    # sbs.transparent_options_button directly does not -- on_new_gui takes it
    # back on the first tagged widget of the next build.)
    gui_options_button()
    gallery_entry_data = gallery_entry(gallery_spec)

    # The lower_third slot is x 20..80, y 74..94. Every panel otherwise runs to
    # y 99 -- including the index on the left, whose right edge the slot clips at
    # x 20..24 -- so the narration landed on top of live content. While a tour is
    # running every panel stops at 68 instead, and the freed band is USED, not
    # left blank: the tour controls sit in it, directly above the narration.
    #
    # Defined HERE, before the first panel that reads it. It was below the index
    # at first and every build raised "gallery_bottom is not defined".
    gallery_bottom = 68 if gallery_tour_running() else 99

# --- header -----------------------------------------------------------------
    gui_section("area: 1, 1, 99, 5;")
    gui_row("row-height: 1fr; font:gui-3;")
    gui_text("$text:`CONTROL GALLERY`;font:gui-3;color:#8cf;", "col-width: content;")
    # Starting the tour lives in the header; DRIVING it lives down beside the
    # narration (see the tour strip below), because controls belong next to the
    # thing they move.
    if not gallery_tour_running():
        on gui_message(gui_button("Take the tour")):
            gallery_step = gallery_tour_start()
            jump gallery_tour_moved
    # On the server screen this is the way back to LM's main screen and its
    # pause/resume controls. Harmless on a console.
    on gui_message(gui_button("Main screen")):
        gui_reroute_server("show_main_game_screen")
    # gallery_label, not gui_text_escape: a blurb reading "use data={}" is an
    # empty format field once gui_text f-string-formats the props.
    gui_text(f"$text:{gallery_label(gallery_entry_data['blurb'])};font:gui-1;color:#9ab;justify:right;")

# --- index ------------------------------------------------------------------
    gui_section(f"area: 1, 6, 24, {gallery_bottom};")
    gui_row("row-height: 1fr;")
    # reveal keeps the selection ON SCREEN; hint keeps it in the SAME SLOT.
    # Without the hint a repaint starts the view at the top, so the row under the
    # mouse moves out from under it -- visible, but not where you left it.
    default gallery_nav_hint = None
    gallery_nav = gui_list_box(gallery_nav_items(), "", item_template=gallery_nav_row, title_template=gallery_nav_title, select=True, collapsible=True, reveal=True, hint=gallery_nav_hint)
    gallery_nav.set_selected_index(gallery_nav_index(gallery_spec), False)

# --- specimen ---------------------------------------------------------------
# A trap runs BROKEN and FIXED side by side and opens its own two frames, so the
# single-specimen frame is only for the rest.
    gallery_is_trap = gallery_entry_data.get("kind") == "trap"
    gallery_showing_page = gallery_entry_data.get("kind") == "page"
    if gallery_showing_page:
        # Full-page examples are DRAWN on the Gallery Viewer console (gallery_pages.mast).
        # Squeezed into this pane they would teach the wrong thing about proportion.
        gallery_remember_page(gallery_spec)
        gallery_frame(f"FULL PAGE   {gallery_entry_data['label']}", "26, 6, 99, 42")
        gallery_caption("Open the GALLERY VIEWER console to see this one at full size.", "#cc0")
        gallery_caption("It shows whichever full-page example you last picked here.")
    if not gallery_is_trap and not gallery_showing_page:
        gallery_frame(f"SPECIMEN   {gallery_entry_data['label']}", "26, 6, 99, 42")

# --- the audience dial (Overlays category only) -----------------------------
# Shared by every overlay specimen, and the reason they are specimens at all: the
# old demo console had twelve near-identical buttons whose only difference was the
# `to=` argument, which is exactly the thing you cannot see from a button.
#
# One dial, and the line under it says what the pick RESOLVES to. Built before the
# match so `overlay_to` is in scope for every case below.
    if gallery_entry_data.get("category") == "Overlays":
# >>gallery: overlay_audience_dial
        default overlay_to_pick = "this screen"
        gui_row("row-height: 1.8em; font:gui-1;")
        gui_text("$text:`Fire at`;font:gui-1;color:#8cf;", "col-width: content;")
        overlay_dial = gui_drop_down(f"text: {overlay_to_pick}; list: {gallery_audience_list()}", var="overlay_to_pick")
        on gui_message(overlay_dial):
            jump gallery_screen
        # A client id, a role set, a ship id, a side name -- all ordinary values.
        overlay_to = gallery_audience(overlay_to_pick)
        overlay_consoles = gallery_audience_consoles(overlay_to_pick)
        gui_row("row-height: 1.6em; font:gui-1;")
        gui_text(f"$text:{gallery_label(gallery_audience_note(overlay_to_pick))};font:gui-1;color:#fc8;")
# <<gallery

    match gallery_spec:
        case "text_basic":
# >>gallery: text_basic
            gui_row("row-height: 2.4em; font:gui-3;")
            gui_text("$text:`Shields nominal`;font:gui-3;color:#8f8;")
            gui_row("row-height: 2.4em; font:gui-3;")
            gui_text("$text:`Hull breach`;font:gui-3;color:#f88;justify:center;")
            gui_row("row-height: 2.4em; font:gui-3;")
            gui_text("$text:`Docking clamps`;font:gui-3;background:#234;justify:right;")
# <<gallery

        case "text_live":
# >>gallery: text_live
            start_counter(client_id, "gallery_clock")
            gui_row("row-height: 2.4em; font:gui-3;")
            gallery_live = gui_text("$text:`Elapsed 0s`;font:gui-3;color:#8cf;")
            # A plain gui_text is built once and goes stale. Keep the handle and
            # update it. .update() REPLACES the WHOLE style string, so carry the
            # font and color or the widget reverts to unstyled left-aligned text.
            on change int(get_counter_elapsed_seconds(client_id, "gallery_clock", 0)):
                gallery_elapsed = int(get_counter_elapsed_seconds(client_id, "gallery_clock", 0))
                gallery_live.update(f"text:`Elapsed {gallery_elapsed}s`;font:gui-3;color:#8cf;")
# <<gallery

        case "button_basic":
# >>gallery: button_basic
            default gallery_shots = 0
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text(f"$text:`Fired {gallery_shots} times`;font:gui-2;color:#9ab;")
            gui_row("row-height: 2.4em; font:gui-2;")
            on gui_message(gui_button("Fire")):
                gallery_shots = gallery_shots + 1
                jump gallery_screen
# <<gallery

        case "checkbox_basic":
# >>gallery: checkbox_basic
            default gallery_alert = False
            gui_row("row-height: 2.4em; font:gui-2;")
            gallery_cb = gui_checkbox(f"text: Red alert; state: {gallery_alert}")
            on gui_message(gallery_cb):
                gallery_alert = not gallery_alert
                jump gallery_screen
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text(f"$text:`Alert is {gallery_alert}`;font:gui-2;color:#9ab;")
# <<gallery

        case "drop_down_basic":
# >>gallery: drop_down_basic
            default gallery_stance = "patrol"
            gui_row("row-height: 2.4em; font:gui-2;")
            gallery_dd = gui_drop_down(f"text: {gallery_stance}; list: patrol, escort, attack, hold", var="gallery_stance")
            on gui_message(gallery_dd):
                jump gallery_screen
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text(f"$text:`Orders: {gallery_stance}`;font:gui-2;color:#9ab;")
# <<gallery

        case "slider_basic":
# >>gallery: slider_basic
            default gallery_power = 5
            gui_row("row-height: 2.4em; font:gui-2;")
            gallery_sl = gui_int_slider("low: 0; high: 10;")
            on gui_message(gallery_sl):
                gallery_power = gallery_sl.value
                jump gallery_screen
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text(f"$text:`Power {gallery_power}`;font:gui-2;color:#9ab;")
# <<gallery

        case "list_box_basic":
# >>gallery: list_box_basic
            # A dict literal needs ~~ ~~ -- MAST parses line by line, so a bare
            # {} broken across lines silently desyncs the whole file.
            gallery_contacts = ~~[{"name": "Raider Alpha", "note": "hostile", "icon": 137}, {"name": "Freighter Bex", "note": "neutral", "icon": 140}, {"name": "Starbase Phoenix", "note": "friendly", "icon": 143}]~~
            gui_row("row-height: 1fr;")
            gallery_lb = gui_list_box(gallery_contacts, "", item_template=gallery_ship_row, title_template=gallery_ship_title, select=True)
            on change gallery_lb.value:
                log(f"selected {gallery_lb.get_value()['name']}", "gallery")
# <<gallery

        case "table_basic":
# >>gallery: table_basic
            gallery_fleet = ~~[{"name": "Artemis", "hull": 100, "side": "tsn"}, {"name": "Hera", "hull": 62, "side": "tsn"}, {"name": "Raider Alpha", "hull": 88, "side": "raider"}]~~
            gallery_cols = ~~[{"key": "name", "label": "Ship"}, {"key": "hull", "label": "Hull", "align": "c", "width": 20}, {"key": "side", "label": "Side", "align": "r", "width": 25}]~~
            gui_row("row-height: 1fr;")
            gui_table(gallery_fleet, gallery_cols, select=True)
# <<gallery

        case "property_list_box_basic":
# >>gallery: property_list_box_basic
            gui_row("row-height: 1fr;")
            gui_property_list_box("Navigation")
            # Each value is an EXPRESSION STRING evaluated later, by the list box
            # -- not here. So it cannot see this task's locals: referencing one
            # is a "name is not defined" at present time. Keep them self-contained.
            #
            # ~~ ~~ is a STATEMENT form, not a sub-expression: inline in a call
            # argument it is a syntax error. Bind the dict first.
            gallery_nav_props = ~~{"Heading": "gui_text('270 mark 5')", "Speed": "gui_text('half impulse')", "Shields": "gui_text('up')"}~~
            gui_properties_set(gallery_nav_props)
# <<gallery

        case "text_area_basic":
# >>gallery: text_area_basic
            # Mini-markdown, and it scrolls itself when the content overflows.
            # '^' is the newline -- the setter maps it to \n.
            gui_row("row-height: 1fr;")
            gui_text_area("## Status^All systems nominal.^- shields up^- 1 contact^^### Orders^1. Hold station^2. Await the escort")
# <<gallery

        case "icon_basic":
# >>gallery: icon_basic
            gui_row("row-height: 3em;")
            gui_icon("icon_index: 137;color:#8cf;", "col-width: content;")
            gui_text("$text:`by sheet index`;font:gui-2;")
            gui_row("row-height: 3em;")
            # By NAME, so a mission can re-skin every screen that draws it.
            # An unknown name draws NOTHING and says so once.
            gui_icon_name("quest.job", color="#cc0", style="col-width: content;")
            gui_text("$text:`by name -- quest.job`;font:gui-2;")
            gui_row("row-height: 3em;")
            gui_icon_name("bell", color="#8f8", style="col-width: content;")
            gui_text("$text:`by name -- bell`;font:gui-2;")
# <<gallery

        case "icon_button_basic":
# >>gallery: icon_button_basic
            default gallery_clicks = 0
            gui_row("row-height: 2em; font:gui-2;")
            gui_text(f"$text:`Clicked {gallery_clicks} times`;font:gui-2;color:#9ab;")
            gui_row("row-height: 3em;")
            gallery_ib = gui_icon_button("icon_index: 137;color:#8cf;", "col-width: content;")
            # An icon fires gui_click, not gui_message.
            on gui_click(gallery_ib):
                gallery_clicks = gallery_clicks + 1
                jump gallery_screen
# <<gallery

        case "radio_basic":
# >>gallery: radio_basic
            default gallery_weapon = "Beam"
            default gallery_wing = "Alpha"
            gui_row("row-height: 2.4em; font:gui-2;")
            gallery_rb = gui_radio("Beam,Missile,Mine", var="gallery_weapon")
            on gui_message(gallery_rb):
                jump gallery_screen
            gui_row("row-height: 1fr;")
            gallery_vrb = gui_vradio("Alpha,Beta,Gamma", var="gallery_wing")
            on gui_message(gallery_vrb):
                jump gallery_screen
            gui_row("row-height: 2em; font:gui-2;")
            gui_text(f"$text:`{gallery_weapon} / {gallery_wing}`;font:gui-2;color:#9ab;")
# <<gallery

        case "input_basic":
# >>gallery: input_basic
            default gallery_callsign = "Artemis"
            gui_row("row-height: 2.4em; font:gui-2;")
            gallery_in = gui_input("", var="gallery_callsign")
            on gui_message(gallery_in):
                jump gallery_screen
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text(f"$text:`Callsign: {gallery_callsign}`;font:gui-2;color:#9ab;")
# <<gallery

        case "slider_float":
# >>gallery: slider_float
            # The range is low/high -- there is no min/max, and no label. An
            # unrecognised key is simply ignored, so a slider with no range at
            # all still draws: a bare line with nothing on it.
            default gallery_shield = 50
            gui_row("row-height: 2.4em; font:gui-2;")
            gallery_fs = gui_slider("low: 0; high: 100; text: float;", var="gallery_shield")
            on gui_message(gallery_fs):
                jump gallery_screen
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text(f"$text:`Shields at {int(gallery_shield)}`;font:gui-2;color:#9ab;")
# <<gallery

        case "grid_basic":
# >>gallery: grid_basic
            # Items wrap to a new row every N -- no manual gui_row() per line.
            gallery_crew = ~~["Helm", "Weapons", "Science", "Engineering", "Comms", "Main"]~~
            with gui_grid(3):
                for gallery_post in gallery_crew:
                    gui_text(f"$text:{gui_text_escape(gallery_post)};font:gui-2;background:#234;")
# <<gallery

        case "face_basic":
# >>gallery: face_basic
            default gallery_face = faces.random_terran()
            gui_row("row-height: 1fr;")
            gui_face(gallery_face)
# <<gallery

        case "ship_basic":
# >>gallery: ship_basic
            gui_row("row-height: 1fr;")
            gui_ship("tsn_light_cruiser")
# <<gallery

        case "image_basic":
# >>gallery: image_basic
            # PREFER AN ATLAS KEY. It names the art once, so every screen that
            # draws it is re-skinned by re-registering the key -- the same
            # argument as icons by name. Art is addressed WITHOUT its extension.
            #
            # media_shared() resolves against this mission's media/ first, then
            # any pack declared under shared_media in story.json. These are
            # LegendaryMissions images, pinned and never copied.
            gui_image_add_atlas("gallery_badge", media_shared("operator"))
            gui_row("row-height: 1fr;")
            gui_image("gallery_badge", fit=3)

            # An atlas key can name a CELL of a sheet. The rect is in PIXELS
            # (left, top, right, bottom), not percent: terran_deck is 2470x1120,
            # a 13x4 grid of 190x280 cards, so this is the first card.
            gui_image_add_atlas("gallery_card", media_shared("casino/terran_deck"), 0, 0, 190, 280)
            gui_row("row-height: 1fr;")
            gui_image("gallery_card", fit=3)

            # The quick form: the file directly, no key. Fine for one-offs, but
            # nothing else can re-skin it.
            gui_row("row-height: 1fr;")
            gui_image(media_shared("artemis_home_page"), fit=3)
# <<gallery

        case "blank_hole":
# >>gallery: blank_hole
            gui_row("row-height: 2.4em; font:gui-2;")
            gui_text("$text:`left`;font:gui-2;background:#234;")
            gui_blank()
            gui_text("$text:`right`;font:gui-2;background:#234;justify:right;")
            gui_row("row-height: 2.4em; font:gui-2;")
            # hole() reserves columns, so the next item spans them.
            gui_hole(2)
            gui_text("$text:`this cell spans the 2 reserved columns`;font:gui-2;background:#243;")
# <<gallery

# ---------------------------------------------------------------------------
# LAYOUT. Sizing is the hardest part of the system to teach in prose, so every
# box here carries a background: the subject IS where the edges land, and an
# unfilled demo of sizing shows nothing at all.
# ---------------------------------------------------------------------------

        case "layout_row_modes":
# >>gallery: layout_row_modes
            gui_row("row-height: 3em; font:gui-2;")
            gui_text("$text:`fixed 3em -- taken off the top`;font:gui-2;background:#234;")
            gui_row("row-height: content; font:gui-2;")
            gui_text("$text:`content -- as tall as its own text`;font:gui-2;background:#243;")
            gui_row("row-height: 1fr; font:gui-2;")
            gui_text("$text:`1fr -- shares what is left`;font:gui-2;background:#325;")
            gui_row("row-height: 1fr; font:gui-2;")
            gui_text("$text:`1fr -- and so does this, equally`;font:gui-2;background:#325;")
# <<gallery

        case "layout_col_modes":
# >>gallery: layout_col_modes
            gui_row("row-height: 3em; font:gui-2;")
            gui_text("$text:`content`;font:gui-2;background:#243;", "col-width: content;")
            gui_text("$text:`1fr takes the rest`;font:gui-2;background:#325;")
            gui_row("row-height: 3em; font:gui-2;")
            # min-content is the widest unbreakable WORD; max-content the whole
            # line, unwrapped. Same text, two very different asks.
            gui_text("$text:`incomprehensible sizing`;font:gui-2;background:#243;", "col-width: min-content;")
            gui_text("$text:`1fr`;font:gui-2;background:#325;")
            gui_row("row-height: 3em; font:gui-2;")
            gui_text("$text:`col-width is a percent of the SECTION`;font:gui-2;background:#432;", "col-width: 40;")
            gui_text("$text:`the other 60`;font:gui-2;background:#325;")
# <<gallery

        case "layout_arithmetic":
# >>gallery: layout_arithmetic
            # em is one line of the ROW's font; padding top/bottom comes out of
            # the row height, so ask for it back.
            gui_row("row-height: 1em; font:gui-3;")
            gui_text("$text:`1em of gui-3`;font:gui-3;background:#234;")
            gui_row("row-height: 1em+16px; font:gui-3;")
            gui_text("$text:`1em+16px -- room for padding`;font:gui-3;background:#243;", "padding: 0, 8px, 0, 8px;")
            gui_row("row-height: 2em-8px; font:gui-3;")
            gui_text("$text:`2em-8px -- subtraction works too`;font:gui-3;background:#325;")
# <<gallery

        case "layout_overflow":
# >>gallery: layout_overflow
            # For text that cannot fit AT ANY SIZE. Not a substitute for sizing
            # the row properly. The engine does not clip by default -- spill
            # draws straight over whatever is next to it.
            gui_row("row-height: 2.2em; font:gui-2;")
            gui_text("$text:`spill (default) -- drawn anyway, over its neighbor`;font:gui-2;background:#234;overflow:spill;", "col-width: 45;")
            gui_blank()
            gui_row("row-height: 2.2em; font:gui-2;")
            gui_text("$text:`shrink -- scaled down until it fits the box`;font:gui-2;background:#243;overflow:shrink;", "col-width: 45;")
            gui_blank()
            gui_row("row-height: 2.2em; font:gui-2;")
            gui_text("$text:`ellipsis -- cut, with a marker at the end`;font:gui-2;background:#325;overflow:ellipsis;", "col-width: 45;")
            gui_blank()
            gui_row("row-height: 2.2em; font:gui-2;")
            gui_text("$text:`hide -- not drawn at all when it will not fit`;font:gui-2;background:#432;overflow:hide;", "col-width: 45;")
            gui_blank()
# <<gallery

# ---------------------------------------------------------------------------
# RECIPES. Composed patterns rather than single widgets -- the shapes a real
# console is made of. A new author copies one of these, not a gui_text call.
# ---------------------------------------------------------------------------

        case "recipe_watch_repaint":
# >>gallery: recipe_watch_repaint
            # A panel usually cannot see the thing it displays change: the work
            # happens in ANOTHER task. So watch the state and repaint when it
            # moves. `on change` takes any expression, not just a variable.
            #
            # The heavier form -- a gui_sub_task_schedule watcher that calls
            # gui_task_jump("repaint") -- is for when the check is expensive or
            # needs its own delay loop. Same shape, more machinery.
            recipe_state = get_inventory_value(client_id, "recipe_build", "idle")
            gui_row("row-height: 2.4em; font:gui-3;")
            gui_text(f"$text:`Build: {recipe_state}`;font:gui-3;color:#8cf;")
            gui_row("row-height: 2.4em; font:gui-2;")
            on gui_message(gui_button("Start a 3 second build")):
                task_schedule(recipe_build_task, {"build_client": client_id})
            on change get_inventory_value(client_id, "recipe_build", "idle"):
                jump gallery_screen
# <<gallery

        case "recipe_status_line":
# >>gallery: recipe_status_line
            # Feedback must land on a surface that is ACTUALLY SHOWN. A console
            # with no info panel silently drops comms_info_card, and the player
            # sees nothing at all -- so a panel that confirms its own actions
            # keeps a status line of its own.
            default recipe_status = "Ready."
            gui_row("row-height: 2.4em; font:gui-2;")
            on gui_message(gui_button("Launch probe")):
                recipe_status = "Probe away."
                jump gallery_screen
            gui_row("row-height: 2.4em; font:gui-2;")
            on gui_message(gui_button("Recall probe")):
                recipe_status = "Probe recalled."
                jump gallery_screen
            gui_row("row-height: 1fr;")
            gui_blank()
            gui_row("row-height: content; font:gui-2;")
            gui_text(f"$text:{gallery_label(recipe_status)};font:gui-2;color:#8f8;background:#243;")
# <<gallery

        case "recipe_item_templates":
# >>gallery: recipe_item_templates
            # The same items, four ways. Swapping item_template is the whole
            # difference -- the listbox, the data and the selection are untouched.
            default recipe_tmpl = "plain"
            recipe_rows = ~~[{"name": "Artemis", "hull": 100, "icon": "quest.job", "note": "flagship, all systems nominal"}, {"name": "Hera", "hull": 62, "icon": "bell", "note": "hull damage aft, damage control en route to deck four"}, {"name": "Aegis", "hull": 88, "icon": "asteroid", "note": "escorting the convoy"}]~~
            gui_row("row-height: 2.4em; font:gui-2;")
            recipe_dd = gui_drop_down(f"text: {recipe_tmpl}; list: plain, banded, icon_value, detail", var="recipe_tmpl")
            on gui_message(recipe_dd):
                jump gallery_screen
            gui_row("row-height: 1fr;")
            gui_list_box(recipe_rows, "", item_template=gallery_template_by_name(recipe_tmpl), select=True)
# <<gallery

        case "recipe_style_def":
# >>gallery: recipe_style_def
            # Declare the look once and hand it to every row. One place to
            # change it, and the rows stop repeating a style string that will
            # eventually disagree with itself.
            recipe_row_style = gui_style_def("row-height: 2.2em; font:gui-3; padding: 8px, 0, 0, 0;")
            gui_row(recipe_row_style)
            gui_text("$text:`Shields`;font:gui-3;background:#234;")
            gui_row(recipe_row_style)
            gui_text("$text:`Reactor`;font:gui-3;background:#243;")
            gui_row(recipe_row_style)
            gui_text("$text:`Sensors`;font:gui-3;background:#325;")
