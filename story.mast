# Control Gallery -- the map, and the mission's shared plumbing.
#
# The gallery itself is in gallery.mast (shell + Controls/Layout/Recipes/Traps/
# Overlays) and gallery_pages.mast (the Gallery Viewer and the full-page
# examples). See sbs_utils/GALLERY_PLAN.md.
#
# What is left HERE is what the specimens need but do not own: the map, the
# labels an overlay schedules (a modal, a HUD watcher), the //overlay route that
# shows a custom kind, and the signal bridge.
#
import gallery_code.py
import gallery_specimens.py
import gallery.mast
import gallery_pages.mast
#
# Overlay System Demo -- Phase 1
#
# A minimal LM-backed mission: one station, player ships, and a custom
# "Overlay Demo" console whose buttons fire overlays over the live 3D view.
# The buttons target the CURRENT console (Phase 1 to=None), so whatever console
# you click on is where the overlay draws -- verifying draw_layer stacking over
# an engine 3dview.

tsn = await prefab_spawn(prefab_side_generic, data={"key":"tsn", "name":"TSN", "color":"#07F"})
raider = await prefab_spawn(prefab_side_generic, data={"key":"raider", "name":"Raider", "color":"#F00"})
side_set_relations(tsn, raider, sbs.DIPLOMACY.HOSTILE)

@media/music/default "Cosmos Default Music"
@media/skybox/sky-bored-alice "borealis"

@map/control_gallery "Control Gallery"
" A browsable catalog of the Cosmos GUI. The gallery opens on the server screen.
metadata: ``` yaml
Properties:
    Player Ships: 'gui_int_slider("$text:int;low: 1.0;high:8.0;", var= "PLAYER_COUNT")'
```
    overlay_doc = document_get_amd_file(get_mission_dir_filename("overlays.amd"))
    amd_overlays(amd_section(overlay_doc, "overlays"))
    shared station_id = to_id(npc_spawn(0, 0, 0, "Starbase Phoenix", "tsn, station", "starbase_command", "behav_station"))
    terrain_spawn_asteroid_sphere(3500, 0, 3500, radius=4000, density=2)
    await task_schedule(spawn_players)
    await task_schedule(docking_standard_player_station)
    quest_doc = document_get_amd_file(get_mission_dir_filename("quests.amd"), data_parser=amd_mission_data)
    for p in to_object_list(role("__player__")):
        quest_grant_amd(p.id, quest_doc)
    # The gallery owns the server screen, so clear the two things that sit on top
    # of it. Both are engine-side and no-ops under the mock, so they can only be
    # judged in a real session.
    #
    # The flag is the DIALOG's state, not the suppression's: 0 hides the connect
    # nag, 1 brings it back (Drop_off turns it off for its intro and back on
    # after). Consoles still connect normally -- this is a server-screen overlay,
    # not the connection mechanism.
    sbs.suppress_client_connect_dialog(0)
    # Per client; 0 is the server machine, 1 turns transparency ON.
    sbs.transparent_options_button(0, 1)
    # ONE console, and it is the gallery's own.
    #
    # The crew consoles were here to give the overlay demo a live 3D view and a
    # second surface to fan out to. The Gallery Viewer does both now -- it morphs
    # into any of them on request (see gallery_pages.mast) -- so offering all
    # seven on the selection screen just buries the two that are the mission.
    #
    # A PLAIN assignment, not `default`: LM's consoles addon declares these with
    # `default ... = True` and addon load order is not deterministic. Plain
    # assignment wins whichever way the order falls -- if this runs first the
    # addon's `default` leaves it alone, and if the addon runs first this
    # overwrites it. A `default` here would be a coin toss.
    HELM_CONSOLE_ENABLED = False
    WEAPONS_CONSOLE_ENABLED = False
    ENGINEERING_CONSOLE_ENABLED = False
    COMMS_CONSOLE_ENABLED = False
    SCIENCE_CONSOLE_ENABLED = False
    MAINSCREEN_CONSOLE_ENABLED = False
    CINEMATIC_CONSOLE_ENABLED = False

    # The map IS the gallery: starting it puts the browser on the SERVER screen,
    # which needs no console and no ship -- what a tool wants to be. It replaces
    # LM's server main-screen (and the pause/resume region on it); "Main screen"
    # in the header hands it back. Consoles carry their own copy too.
    #
    # Label by STRING, not by bare name: a bare identifier is evaluated as a
    # Python expression, and a label is not a Python global. do_jump resolves a
    # string against the story's label table instead.
    gui_reroute_server("gallery_screen")
    ->END

# Custom overlay builder authored as a //overlay route (the sugar form): no Python,
# no registration call. Content fields (title, sub) arrive as task vars.
//overlay/custom_card
    gui_row("row-height: content;")
    gui_text(f"$text:`{title}`;justify:center;font:gui-6;color:#0f0")
    gui_row("row-height: content;")
    gui_text(f"$text:`{sub}`;justify:center;font:gui-3;color:#8f8")

# Modal choice: await the result from a background task, then react. Scheduled by
# the "modal choice" specimen -- a GUI task is already in await gui() and cannot
# await anything else, so the awaiting has to happen somewhere that can.
=== demo_choice
    result = await overlay_choice("Fire on the ambassador?", ["Yes", "No"], to=choice_client)
    overlay_clear("center_hero", to=choice_client)
    overlay_toast(f"You chose: {result.data}", to=choice_client, seconds=4)
    ->END

# Sticky HUD watcher: update the live values only when they change (watch/repaint
# at the value level). Reads the alert state a control button toggles.
=== hud_watch
    tick = 0
--- hud_watch_loop
    await delay_sim(1)
    ->END if not object_exists(sbs.get_ship_of_client(hud_client))
    tick = tick + 1
    alert = get_inventory_value(hud_client, "hud_alert", "GREEN")
    overlay_hud_update(rows={"Tick": tick, "Alert": alert}, to=hud_client)
    jump hud_watch_loop

# HUD control (runs as a sub-task so it doesn't hijack the console gui): flip the
# alert state; the watcher reflects it on its next tick.
=== hud_toggle_alert
    cur = get_inventory_value(hud_client, "hud_alert", "GREEN")
    set_inventory_value(hud_client, "hud_alert", "RED" if cur == "GREEN" else "GREEN")
    ->END

# --- Signal bridge (mission-authored; forwards to the overlay helpers) --------
# One dispatch on the server, fans out to the signal's `to` targets.
//shared/signal/overlay
    overlay_signal_show(to, slot, kind, fields)

//shared/signal/overlay_clear
    overlay_signal_clear(to, slot)
