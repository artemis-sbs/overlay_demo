{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Dbg w/Gui",
            "type": "debugpy",
            "request": "launch",
            "module": "cosmos_dev.mission_runner",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/../control_gallery",
            "envFile": "${workspaceFolder}/../control_gallery/.env",
            "args": [".", "--gui", "--map", "0"],
            "subProcess": false
        },
        {
            "name": "Dbg no Gui",
            "type": "debugpy",
            "request": "launch",
            "module": "cosmos_dev.mission_runner",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/../control_gallery",
            "envFile": "${workspaceFolder}/../control_gallery/.env",
            "args": [".", "--map", "0"],
            "subProcess": false
        },

        // --- MAST source debugger (breakpoints in .mast) --------------------
        {
            "name": "MAST: Debug mission (one click)",
            "type": "mast",
            "request": "launch",
            "mission": "${workspaceFolder}/../control_gallery",
            "map": "0"
        }

    ]
}
